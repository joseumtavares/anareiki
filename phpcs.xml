<?xml version="1.0"?>
<ruleset name="anareiki">
    <description>PSR-12 para o código PHP do projeto (RULES.md §11).</description>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <file>admin</file>
    <file>api</file>
    <file>includes</file>
    <file>index.php</file>
    <file>agendar.php</file>
    <file>confirmacao-agendamento.php</file>
    <file>bin</file>
    <file>tests</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>config.php</exclude-pattern>

    <rule ref="PSR12"/>

    <!-- Páginas .php misturam HTML e PHP por desenho (monólito renderizado no servidor). -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>admin/*</exclude-pattern>
        <exclude-pattern>api/*</exclude-pattern>
        <exclude-pattern>bin/*</exclude-pattern>
        <exclude-pattern>includes/*</exclude-pattern>
        <exclude-pattern>index.php</exclude-pattern>
        <exclude-pattern>agendar.php</exclude-pattern>
        <exclude-pattern>confirmacao-agendamento.php</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <!-- Testes PHPUnit permanecem no escopo global para acessar as funções legadas. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <!-- Nomes de teste descritivos em português com sublinhado. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
